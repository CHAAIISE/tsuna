{
  "name": "leash",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DeFi vaults on Stellar with on-chain limits for AI agents.",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --dir web dev",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p scripts/tsconfig.json",
    "lint": "pnpm -r lint && eslint scripts",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "capture:product": "tsx scripts/capture-product.ts",
    "contracts:build": "stellar contract build --manifest-path contracts/Cargo.toml",
    "contracts:test": "cargo test --manifest-path contracts/Cargo.toml --workspace"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.64.1",
    "@stellar/stellar-sdk": "^17.4.0",
    "@types/node": "^22.19.0",
    "eslint": "^9.39.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^5.0.5"
  }
}
