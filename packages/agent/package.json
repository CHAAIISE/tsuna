{
  "name": "@leash/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./keeper": {
      "types": "./dist/keeper.d.ts",
      "default": "./dist/keeper.js"
    }
  },
  "scripts": {
    "prepare": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "build": "tsc -p tsconfig.build.json",
    "agent": "tsx src/cli.ts",
    "attacks": "tsx src/attacks/cli.ts",
    "keeper": "tsx src/keeper-cli.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.102",
    "@leash/sdk": "workspace:*",
    "@stellar/mpp": "0.7.1",
    "@stellar/stellar-sdk": "^17.4.0",
    "@x402/core": "2.28.0",
    "ai": "^7.0.153",
    "mppx": "0.6.31",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
